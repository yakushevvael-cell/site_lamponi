[Unit]
Description=Остатки Lamponi каждый час

[Timer]
# В :10 рядом запускается короткий цикл заказов. Общий flock гарантирует, что
# полная выгрузка начнётся только после него либо возьмёт резерв прошлого
# пятиминутного цикла; одновременно две отправки не выполняются.
OnCalendar=*:10
RandomizedDelaySec=180
Persistent=true

[Install]
WantedBy=timers.target
