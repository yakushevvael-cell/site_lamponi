[Unit]
Description=Lamponi: проверка остатков на площадках после корректировки
After=lamponi.service
Requires=lamponi.service

[Service]
Type=oneshot
User=lamponi
Group=lamponi
WorkingDirectory=/opt/lamponi/current
EnvironmentFile=/opt/lamponi/shared/.env
ExecStart=/usr/bin/node scripts/sync-task.mjs checks
