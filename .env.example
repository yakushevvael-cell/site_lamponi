# Пример настроек. На сервере файл называется .env и лежит рядом с приложением.
# Секреты в репозиторий не попадают: .env закрыт в .gitignore.

# Куда класть базу, загруженные ОСВ и резервные копии.
DATA_DIR=/var/lib/lamponi

# 32 случайных байта в base64. Этим ключом шифруются API-ключи маркетплейсов
# в базе. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВНИМАНИЕ: при потере ключа сохранённые API-ключи расшифровать нельзя —
# их придётся добавить заново.
CREDENTIALS_MASTER_KEY=

# Секрет для запуска фоновой синхронизации по расписанию.
# Сгенерировать так же, как ключ выше.
SYNC_TASK_TOKEN=

# Адрес сайта — нужен фоновой задаче, чтобы обращаться к своему же приложению.
APP_URL=https://fbs.lamponi.store

# Порт, на котором слушает приложение (nginx проксирует на него).
PORT=3000
